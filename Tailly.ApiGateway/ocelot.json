{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/Auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/Auth/me/security/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/me/security/{everything}",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/Media/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "clientprofile",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/Media/{everything}",
      "UpstreamHttpMethod": [ "POST", "GET", "PUT", "DELETE" ],
      "FileUpload": true,
      "Priority": 0
    },
    {
      "DownstreamPathTemplate": "/api/ClientProfile/me",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "clientprofile",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/me/profile",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/Pet",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "clientprofile",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/me/pets",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/Pet/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "clientprofile",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/me/pets/{id}",
      "UpstreamHttpMethod": [ "PUT", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/ClientProfile/me/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "clientprofile",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/me/profile/{everything}",
      "UpstreamHttpMethod": [ "PUT" ]
    },
    {
      "DownstreamPathTemplate": "/api/Breed",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "clientprofile",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/pets/breeds",
      "UpstreamHttpMethod": [ "GET" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}